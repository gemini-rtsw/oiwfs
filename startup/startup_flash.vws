# $Id: startup_flash.vws,v 1.1.2.1 2010-11-23 19:33:00 gemvx Exp $
#
# VxWorks startup script to load and execute system (iocCore) software.
#
# STAND-ALONE VERSION TO FLASH THE SDSU VME EEPROM
#

shellPromptSet "sdsu flash> "

# Make delete key work for backspace
tyBackspaceSet 0177

# cd to application install directory (beware automounter problems)
cd "$(iocpath)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# This file also performs NFS mounts.

< $(version)/bin/$(arch)/local

# Load EPICS core, sequencer and pvload
ld < /gemini/external/GEM8.4/base/bin/$(arch)/iocCore
ld < /gemini/external/GEM8.4/base/bin/$(arch)/seq
ld < /gemini/external/GEM8.4/extensions/bin/$(arch)/pvload

# Records, device and driver support for a Gemini base system
ld < $(version)/bin/$(arch)/gemini$(dbname).Support

# Load the syncho bus driver
ld < $(version)/bin/$(arch)/drvVmi5588

# Load the Gemini astrometric and time libraries
ld < /gemini/epics3.13.4/slalib/slalib/bin/$(arch)/slalib
ld < /gemini/epics3.13.4/timelib/timelib/bin/$(arch)/timelib
ld < /gemini/epics3.13.4/astlib/astlib/bin/$(arch)/astlib
ld < /gemini/epics3.13.4/cfitsio/cfitsio/bin/$(arch)/cfitsiolib

# Load the Gemini data handling libraries
ld < /gemini/dhs/dhs/external/lib/mv2700T2/libers.o
ld < /gemini/dhs/dhs/external/lib/mv2700T2/libimp.o
ld < /gemini/dhs/dhs/external/lib/mv2700T2/libsds.o
ld < /gemini/dhs/dhs/lib/mv2700T2/libgen.a
ld < /gemini/dhs/dhs/lib/mv2700T2/libdhs.a

# Load the Gemini A&G wavefront processing software
ld < $(version)/bin/$(arch)/wfsDb
ld < $(version)/bin/$(arch)/wfsSite
ld < $(version)/bin/$(arch)/wfsLibraries
ld < $(version)/bin/$(arch)/detControl
ld < $(version)/bin/$(arch)/wfsControl
ld < $(version)/bin/$(arch)/wfsResourceMonitor
ld < $(version)/bin/$(arch)/simpleLog
ld < $(version)/bin/$(arch)/fpscr

# Load test harness library if required
ld < $(version)/bin/$(arch)/testKit

#Turn off floating point underflow for each tasks
taskCreateHookAdd( usrFppCreateHook )

# Do not allow to use D64 cycles on the bus
*0xfd050128 &= 0xffffbfff

# Create SDSU VME context and reset the board
wfsid = sdsuContextCreate (0x08000000, 0)
sdsuReset (wfsid, 1)
