# Init file for control structure of OIWFS GMOS
# Name of the bin dark fits file (string)
data/defBinOiGmosDarkMK.fits
# Name of the bin flat fits file (string)
data/defBinOiGmosFlatMK.fits
# Name of the AO SH reference file (string)
data/test32BinRefOiGmos.dat
# Value for the x center for the whole CCD (double)
20.5
# Value for the y center for the whole CCD (double)
20.5
# aO modes number to correct (int)
19
# FG modes number to correct (int)
3
# Name of aO scale factor file
data/defAoScaleOiGmos.dat
# Name of aO interaction matrix file
data/defAoIntMatOiGmosMK.dat
# Name of aO control matrix file
data/defAoContMatOiGmosMK.dat
# Name of FG control matrix file
data/defFgContMatOiGmosMK.dat
# Scale factor for tip mode (double)
0.1
# Scale factor for tilt mode (double)
0.1
# Scale factor for focus mode at 100Hz (double)
0.0003
# Gain for focus sliding average (double)
0.0005
# RMS value (double)
9
# Threshold value for pixel (double)
50
# Threshold value for total counts (double)
0
# Port  used by default (integer: 1, 3, 5)
5
# Port Angle_M2(rd) Flip_X_M2 Flip_Y_M2 Angle_M1(rd) Flip_X_M1 Flip_Y_M1
  1    1.5708       1.0       1.0       1.5708       1.0       1.0
  3    0.0          1.0       1.0       0.0          1.0       1.0
  5    1.5708       1.0       -1.0      1.5708       1.0       -1.0
# Name of seeing coefficient matrix file
data/defSeeingCoeffMatOiGmosMK.dat
# Name of seeing coefficient vector file
data/defSeeingCoeffVectOiGmosMK.dat
# Scale factor for seeing computation (double)
1.02
