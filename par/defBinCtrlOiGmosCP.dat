data/defBinOiGmosDarkCP.fits
# Name of the bin flat fits file (string)
data/defBinOiGmosFlatCP.fits
# Name of the AO SH reference file (string)
data/defBinRefOiGmos.dat
# Value for the x center for the whole CCD (double)
20.5
# Value for the y center for the whole CCD (double)
20.5
# aO modes number to correct (int)
19
# FG modes number to correct (int)
3
# Name of aO scale factor file
data/defAoScaleOiGmos.dat
# Name of aO interaction matrix file
data/defAoIntMatOiGmosCP.dat
